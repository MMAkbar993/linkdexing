# ----------------------------------------------------------------------------
# Linkdexing - Admin panel (Create React App)
# Template. Copy to .env (cp .env.example .env) and fill in the real values.
# Keep this file committed with EMPTY values only - never commit real secrets.
#
# NOTE: only variables prefixed with REACT_APP_ are exposed to the browser,
# and they are baked into the build - so never put a private secret here.
# Restart the dev server after changing this file.
# ----------------------------------------------------------------------------

# Dev server port. CRA defaults to 3000 if empty.
PORT=

# Base URL of the backend API, no trailing slash.
# Used by src/api/index.js:3 and by the /api dev proxy in src/setupProxy.js:7
REACT_APP_BASE_URL=

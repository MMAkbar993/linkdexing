# Dependencies
node_modules/

# Build output - rebuilt on the server
build/

# Secrets - real values never go in git. The .env.example templates do.
.env
.env.*
!.env.example

# Private deployment notes
DEPLOY*.md

# Editor config. A hidden auto-run task in .vscode/tasks.json is how malware
# got into the previous repos - keep this folder out of the repo entirely.
.vscode/

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
